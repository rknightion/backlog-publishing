---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Individual records are noindex: ~900 thin tracker pages are not what we
      want competing with m7kni.io in search. Indexes and boards are indexable
      so the site is still linkable and discoverable. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Set the theme before first paint, or a dark-mode visitor gets a white
        flash on every navigation. Inline and synchronous on purpose. */}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") {
            document.documentElement.dataset.theme = saved;
          }
        } catch {
          /* Private mode or blocked storage. The media query still applies. */
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="shell">
        <a class="brand" href="/">
          <span aria-hidden="true">&#9645;</span>
          <span>Backlogs<small>m7kni.io</small></span>
        </a>
        <nav>
          <a href="/">Projects</a>
          <a href="/search/">Search</a>
          <button class="theme-toggle" type="button" data-theme-toggle aria-live="polite">
            Theme
          </button>
        </nav>
      </div>
    </header>

    <main class="shell">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        <span>
          Published from Backlog.md trackers. Read-only; the repository is the source of truth.
        </span>
        <span>
          <a href="https://m7kni.io">Documentation</a> &middot;
          <a href="https://github.com/rknightion">GitHub</a>
        </span>
      </div>
    </footer>

    <script is:inline>
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        root.dataset.theme = dark ? "light" : "dark";
        try {
          localStorage.setItem("theme", root.dataset.theme);
        } catch {
          /* Nothing to persist to. The page still switches for this visit. */
        }
      });
    </script>
  </body>
</html>
